<super:BaseDialog
    x:Class="Jvedio.Window_MergeActor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:super="https://github.com/SuperStudio/SuperControls"
    Title="{DynamicResource MergeActorTitle}"
    Width="860"
    Height="600"
    MinWidth="640"
    MinHeight="420"
    Background="{DynamicResource Window.InnerDialog.Background}"
    Foreground="{DynamicResource Window.Foreground}"
    Icon="pack://application:,,,/Resources/Jvedio.ico"
    Loaded="BaseDialog_Loaded"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d" FontSize="{DynamicResource GlobalFontSize}">

    <super:BaseDialog.Resources>
        <Style
            x:Key="MergeListBoxItemStyle"
            BasedOn="{StaticResource NormalListBoxItem}"
            TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,5" />
        </Style>
    </super:BaseDialog.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <!--  被合并演员  -->
        <TextBlock
            Grid.Row="0"
            FontWeight="Bold"
            Style="{StaticResource BaseTextBlock}"
            Text="{Binding SourceSummary}"
            TextWrapping="Wrap" />

        <!--  说明  -->
        <TextBlock
            Grid.Row="1"
            Margin="0,4,0,8"
            FontSize="{DynamicResource GlobalFontSize12}"
            Foreground="{DynamicResource Window.Sub.Foreground}"
            Style="{StaticResource BaseTextBlock}"
            Text="{DynamicResource MergeActorSourceTip}"
            TextWrapping="Wrap" />

        <!--  搜索目标  -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource BaseTextBlock}"
                Text="{DynamicResource MergeActorTargetSearch}" />
            <super:SearchBox
                Name="targetSearchBox"
                Width="320"
                Margin="10,0,0,0"
                Search="TargetSearchBox_Search"
                Style="{StaticResource SearchBoxStyle}"
                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <!--  候选列表  -->
        <ListBox
            Grid.Row="3"
            Margin="0,8,0,0"
            Background="Transparent"
            ItemContainerStyle="{StaticResource MergeListBoxItemStyle}"
            ItemsSource="{Binding Candidates}"
            MouseDoubleClick="CandidateList_MouseDoubleClick"
            SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
            ScrollViewer.HorizontalScrollBarVisibility="Hidden"
            Style="{StaticResource NormalListBox}"
            VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="42"
                            Height="42"
                            Margin="0,0,10,0"
                            BorderBrush="{DynamicResource Button.Selected.BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding SmallImage}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                FontWeight="Bold"
                                Style="{StaticResource BaseTextBlock}"
                                Text="{Binding ActorName}"
                                ToolTip="{Binding ActorName}" />
                            <TextBlock
                                FontSize="{DynamicResource GlobalFontSize12}"
                                Foreground="{DynamicResource Window.Sub.Foreground}"
                                Style="{StaticResource BaseTextBlock}"
                                Text="{Binding ActorNameEN}"
                                ToolTip="{Binding ActorNameEN}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource GlobalFontSize12}"
                            Foreground="{DynamicResource Window.Sub.Foreground}"
                            Style="{StaticResource BaseTextBlock}"
                            Text="{Binding Count, StringFormat=作品 {0}}"
                            ToolTip="{DynamicResource WorkCount}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!--  底部操作  -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource BaseTextBlock}"
                Text="{Binding TargetSummary}" />
            <Button
                Grid.Column="1"
                MinWidth="110"
                Height="30"
                Click="Merge_Click"
                Content="{DynamicResource MergeActorExecute}"
                IsEnabled="{Binding HasTarget}"
                Style="{StaticResource ButtonPrimary}" />
        </Grid>
    </Grid>
</super:BaseDialog>
